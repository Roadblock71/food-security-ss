{
  "functions": {
    "api/predict.py": {
      "runtime": "python3.12",
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "model/**"
    }
  },
  "rewrites": [
    { "source": "/api/health",        "destination": "/api/predict" },
    { "source": "/api/predict",       "destination": "/api/predict" },
    { "source": "/api/predict_batch", "destination": "/api/predict" }
  ]
}